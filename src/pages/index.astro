---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';

const initials = site.name.split(' ').map((w) => w[0]).join('');
---

<PageLayout title={site.defaultTitle} description={site.defaultDescription}>

  <!-- ======================== HERO ======================== -->
  <section class="pt-14 lg:pt-20 pb-12 lg:pb-16">
    <div class="section-container max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-widest text-accent mb-8">
        Freelance · Webs para negocios locales de servicios
      </p>

      <div class="flex items-start gap-4 mb-10">
        <div class="flex-shrink-0 w-14 h-14 rounded-full bg-cream-dark flex items-center justify-center">
          <span class="text-sm font-bold text-ink-soft">{initials}</span>
        </div>
        <p class="text-ink-soft leading-relaxed pt-1.5">
          Soy Yerai. Trabajo con negocios de servicios locales que necesitan que su web les traiga clientes de
          verdad, no solo visitas.
        </p>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-[1.25] mb-8 text-ink">
        Construyo webs que consiguen clientes para negocios locales:
        <span class="text-accent">SEO técnico, contenido con IA validado</span>
        y email marketing — casi nadie vende los tres juntos.
      </h1>

      <p class="text-lg text-ink-soft mb-8 max-w-xl leading-relaxed">
        Blogs que se autoalimentan con IA sin publicar errores, SEO técnico riguroso y automatizaciones de email
        marketing, todo montado y verificado en un proyecto real.
      </p>

      <a href="/contacto/" class="link-cta text-lg">
        Cuéntame qué necesitas →
      </a>
    </div>
  </section>

  <div class="section-container"><div class="hairline"></div></div>

  <!-- ======================== SERVICIOS ======================== -->
  <section id="servicios" class="section-padding">
    <div class="section-container">
      <p class="text-sm font-bold uppercase tracking-widest text-ink-soft mb-10">Servicios</p>

      <div>
        {site.pillars.map((p, i) => (
          <div class:list={["grid sm:grid-cols-[64px_1fr] gap-3 sm:gap-8 py-8", i > 0 && "hairline"]}>
            <span class="text-2xl font-bold text-ink/20">{String(i + 1).padStart(2, '0')}</span>
            <div class="max-w-2xl">
              <h3 class="font-bold text-ink text-xl mb-2">{p.title}</h3>
              <p class="text-ink-soft leading-relaxed">{p.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== CÓMO TRABAJO ======================== -->
  <section class="section-padding bg-cream-dark">
    <div class="section-container max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-ink-soft mb-10">Cómo trabajo</p>

      <div>
        {site.howIWork.map((item, i) => (
          <div class:list={["py-6", i > 0 && "hairline"]}>
            <p class="text-ink leading-relaxed">
              <span class="font-bold">{item.title}.</span> {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== PROYECTO ======================== -->
  <section id="proyecto" class="section-padding">
    <div class="section-container max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-ink-soft mb-10">Proyecto real</p>

      {site.projects.map((p) => (
        <div>
          <p class="text-sm font-semibold text-accent mb-3">En producción</p>
          <h3 class="font-bold text-ink text-3xl mb-4">{p.name}</h3>
          <p class="text-ink-soft leading-relaxed mb-4 max-w-xl">{p.shortDesc}</p>
          <p class="text-sm text-ink-soft mb-6">{p.tags.join(', ')}</p>
          <div class="flex flex-wrap gap-x-8 gap-y-2">
            <a href={`/proyectos/${p.slug}/`} class="link-cta">Ver caso de estudio →</a>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="link-cta">Visitar la web ↗</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="section-container"><div class="hairline"></div></div>

  <!-- ======================== CIERRE ======================== -->
  <section class="section-padding">
    <div class="section-container max-w-2xl">
      <h2 class="text-2xl lg:text-3xl font-bold text-ink mb-4">
        ¿Tienes un negocio local y tu web no capta clientes?
      </h2>
      <p class="text-ink-soft text-lg mb-6 max-w-xl">
        Cuéntame qué haces y qué falla. Te respondo con una valoración honesta, no una plantilla de venta.
      </p>
      <a href="/contacto/" class="link-cta text-lg">Hablemos →</a>
    </div>
  </section>

</PageLayout>
