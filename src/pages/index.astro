---
import PageLayout from '../layouts/PageLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site.config';

const [hero, second] = site.cases;

const included = [
  { title: 'Una página por servicio', text: 'Cada trabajo que haces se busca por separado en Google, así que cada uno tiene su página, su título y sus preguntas frecuentes.' },
  { title: 'Una página por localidad', text: 'Para salir en los pueblos de tu zona y no solo en la capital, con texto escrito para cada sitio.' },
  { title: 'Llamada y WhatsApp en un toque', text: 'Botón de llamada fijo en el móvil, formulario de presupuesto y WhatsApp. El cliente no tiene que buscar cómo contactarte.' },
  { title: 'Ficha de Google enlazada', text: 'Nombre, dirección y teléfono iguales en la web y en tu ficha, con datos estructurados de empresa local.' },
  { title: 'Blog que se escribe solo', text: 'Un artículo a la semana sobre dudas reales de tus clientes. Si no pasa los controles, no se publica.' },
  { title: 'Rápida y sin cookies', text: 'Imágenes optimizadas, carga rápida en el móvil y medición de visitas sin banner de cookies.' },
];
---

<PageLayout title={site.defaultTitle} description={site.defaultDescription}>

  <!-- ======================== HERO ======================== -->
  <section class="overflow-hidden">
    <div class="section-container pt-12 lg:pt-20 pb-16 lg:pb-24 grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow mb-6">Para empresas de tejados, reformas y pavimentos</p>
        <h1 class="text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold leading-[1.08] tracking-tight text-ink">
          Clientes de tu zona <span class="text-accent">llamándote a ti</span>, no a tu competencia.
        </h1>
        <p class="mt-6 text-lg text-ink-soft leading-relaxed max-w-xl">
          Soy Yerai. Hago webs que salen en Google para un oficio en una ciudad y se las cedo a un solo negocio de esa
          zona. Tú recibes las llamadas y pagas una cuota al mes, sin inversión inicial.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="/consulta-tu-zona/" class="btn-cta text-base">¿Está libre tu zona?</a>
          <a href="/como-funciona/" class="link-cta">Cómo funciona →</a>
        </div>
        <p class="mt-6 text-sm text-ink-soft">Un solo negocio por oficio y zona. Sin reseñas falsas ni fichas de Google alquiladas.</p>
      </div>

      <div class="relative lg:pl-6">
        <BrowserFrame src={hero.image} alt={`Portada de ${hero.name}`} url={hero.url} eager />
        <div class="phone absolute -bottom-10 -left-2 sm:left-auto sm:-right-4 w-[34%] max-w-[180px] hidden sm:block">
          <img src="/casos/impermeabilizaciones-benidorm-movil.webp" alt={`${second.name} en el móvil`} width="390" height="780" class="block w-full h-auto" />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== CIFRAS ======================== -->
  <section class="border-y border-ink/10 bg-cream-dark">
    <div class="section-container py-8 grid grid-cols-2 lg:grid-cols-4 gap-6">
      {site.stats.map((s) => (
        <div>
          <p class="text-3xl lg:text-4xl font-extrabold text-ink">{s.value}</p>
          <p class="mt-1 text-sm text-ink-soft leading-snug">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ======================== OFICIOS ======================== -->
  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Por oficio</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-ink leading-tight">Cada oficio se busca distinto. Cada web también.</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {site.verticals.map((v) => {
          const cases = site.cases.filter((c) => c.vertical === v.slug);
          return (
            <a href={`/${v.slug}/`} class="card p-6 lg:p-7 hover:border-accent transition-colors group">
              <p class="text-sm font-semibold text-accent">{cases.length > 0 ? `${cases.length} ${cases.length === 1 ? 'web' : 'webs'} en producción` : 'Webs en preparación'}</p>
              <h3 class="mt-2 text-xl font-bold text-ink">Webs para {v.trade}</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{v.pages.slice(0, 4).join(' · ')}…</p>
              <span class="mt-4 inline-block font-bold text-ink group-hover:text-accent-dark">Ver cómo es →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ======================== CASOS ======================== -->
  <section class="section-padding bg-cream-dark">
    <div class="section-container">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">Webs publicadas</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-ink leading-tight">Negocios reales, webs en producción</h2>
        </div>
        <a href="/casos/" class="link-cta">Todos los casos →</a>
      </div>
      <div class="mt-10 grid gap-12 md:grid-cols-2 lg:grid-cols-3">
        {site.cases.map((c) => <CaseCard item={c} />)}
      </div>
      <div class="mt-12 card p-6">
        <p class="font-bold text-ink">En preparación</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {site.upcoming.map((u) => (
            <li class="rounded-full border border-ink/15 px-3 py-1 text-sm text-ink-soft">{u.sector} · {u.place}</li>
          ))}
        </ul>
        <p class="mt-3 text-sm text-ink-soft">Se enseñarán como caso cuando estén publicadas, no antes.</p>
      </div>
    </div>
  </section>

  <!-- ======================== QUÉ INCLUYE ======================== -->
  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Qué lleva cada web</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-ink leading-tight">Todo lo que hace falta para salir en Google en tu zona</h2>
      </div>
      <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {included.map((f, i) => (
          <div class="hairline pt-6">
            <span class="text-sm font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-lg font-bold text-ink">{f.title}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== HERRAMIENTAS ======================== -->
  <section class="section-padding bg-cream-dark">
    <div class="section-container grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <p class="eyebrow mb-3">Después de publicar</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-ink leading-tight">La web no se queda olvidada</h2>
        <p class="mt-4 text-ink-soft text-lg leading-relaxed">
          Cada lunes reviso todas las webs con datos de Google Search Console. Cada mes hay un informe con lo que ha
          cambiado y, como mucho, tres cosas que hacer.
        </p>
        <ul class="mt-8 space-y-6">
          {site.tools.map((t) => (
            <li>
              <p class="font-bold text-ink">{t.name}</p>
              <p class="mt-1 text-ink-soft leading-relaxed">{t.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <figure>
        <BrowserFrame src="/casos/dashboard-seo.webp" alt="Panel interno con los datos de Search Console de cada web, con las cifras difuminadas" />
        <figcaption class="mt-3 text-sm text-ink-soft">Mi panel interno. Las cifras están difuminadas a propósito: son de cada negocio.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ======================== CÓMO TRABAJO ======================== -->
  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Cómo trabajo</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-ink leading-tight">Rigor antes que atajos</h2>
      </div>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {site.process.map((p, i) => (
          <li>
            <span class="flex w-9 h-9 items-center justify-center rounded-full bg-accent-light text-accent-dark font-bold">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold text-ink">{p.title}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{p.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-14 grid gap-4 lg:grid-cols-3">
        {site.principles.map((p) => (
          <div class="card p-6">
            <p class="font-bold text-ink">{p.title}</p>
            <p class="mt-2 text-ink-soft leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== CÓMO FUNCIONA ======================== -->
  <section class="section-padding bg-cream-dark">
    <div class="section-container">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">Cómo funciona</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-ink leading-tight">No te vendo una web. Te cedo una que trae clientes.</h2>
        </div>
        <a href="/como-funciona/" class="link-cta">Todos los detalles →</a>
      </div>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {site.offer.steps.map((p, i) => (
          <li>
            <span class="flex w-9 h-9 items-center justify-center rounded-full bg-accent text-cream font-bold">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold text-ink">{p.title}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{p.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-14">
        <h3 class="text-xl font-bold text-ink">En qué me diferencio de otros que alquilan webs o venden contactos</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {site.differentiators.map((d) => (
            <div class="card p-6">
              <p class="font-bold text-ink">{d.title}</p>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed">{d.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand />

</PageLayout>
