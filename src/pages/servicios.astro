---
import PageLayout from '../layouts/PageLayout.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site.config';

const title = `Servicios y precios: web para oficios, alquiler de web y SEO local | ${site.name}`;
const description =
  'Precios claros para empresas de oficios: web propia, web en alquiler sin inversión inicial, optimización de la ficha de Google y SEO mensual.';

const faqs = [
  { q: '¿Qué diferencia hay entre comprar y alquilar la web?', a: 'Si la compras, el dominio y la web son tuyos desde el primer día y pagas un mantenimiento pequeño. Si la alquilas, no pones dinero al principio: pagas al mes mientras te traiga trabajo y tienes la exclusiva de tu oficio en tu zona.' },
  { q: '¿Hay permanencia?', a: 'En el SEO mensual no. En el alquiler, la mínima para que la web tenga tiempo de posicionar; se acuerda antes de empezar y por escrito.' },
  { q: '¿Me garantizas salir el primero en Google?', a: 'No, y desconfía de quien te lo garantice: depende de tu competencia, de tu ficha y de tus reseñas. Lo que sí te garantizo es una web bien hecha, datos reales y un informe mensual de lo que pasa.' },
  { q: '¿Los precios llevan IVA?', a: 'Los precios son orientativos y sin IVA. El presupuesto exacto sale de la auditoría, según los servicios y las zonas que trabajes.' },
];
---

<PageLayout title={title} description={description}>

  <section>
    <div class="section-container pt-10 lg:pt-16 pb-10 max-w-3xl">
      <p class="eyebrow mb-4">Servicios y precios</p>
      <h1 class="text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-ink">Compra tu web, alquílala o mejora la que tienes</h1>
      <p class="mt-6 text-lg text-ink-soft leading-relaxed">
        Precios orientativos para que sepas de qué hablamos antes de escribirme. El presupuesto exacto depende de
        cuántos servicios y zonas trabajes.
      </p>
    </div>
  </section>

  <section class="pb-16 lg:pb-24">
    <div class="section-container grid gap-5 md:grid-cols-2">
      {site.services.map((s, i) => (
        <article id={s.slug} class:list={['card p-7 lg:p-8 flex flex-col scroll-mt-28', i === 1 && 'border-accent ring-1 ring-accent']}>
          {i === 1 && <p class="text-xs font-bold uppercase tracking-widest text-accent mb-3">Sin inversión inicial</p>}
          <h2 class="text-2xl font-bold text-ink">{s.name}</h2>
          <p class="mt-3 text-ink-soft leading-relaxed">{s.summary}</p>
          <ul class="check-list mt-6 space-y-2.5 text-ink flex-1">
            {s.includes.map((x) => <li>{x}</li>)}
          </ul>
          <div class="mt-8 hairline pt-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-3xl font-extrabold text-ink">{s.price}</p>
              <p class="text-sm text-ink-soft">{s.priceNote}</p>
            </div>
            <a href="/auditoria-gratis/" class="btn-primary text-sm">Empezar por la auditoría</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container max-w-3xl">
      <p class="eyebrow mb-3">Preguntas frecuentes</p>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />

</PageLayout>
