---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';

const title = 'Contacto — ' + site.name;
const description = 'Escríbeme para hablar de la web de tu negocio de tejados, reformas, pavimentos o fontanería.';
---

<PageLayout title={title} description={description}>

  <section class="section-padding min-h-[60vh] flex items-center">
    <div class="section-container max-w-2xl">
      <p class="eyebrow mb-4">Contacto</p>
      <h1 class="text-3xl lg:text-4xl font-bold text-ink mb-4">Hablemos de tu web</h1>
      <p class="text-ink-soft text-lg mb-10 max-w-xl">
        Cuéntame qué haces, dónde trabajas y qué te gustaría conseguir. Te respondo yo directamente, sin plantillas.
      </p>

      <div class="flex flex-col gap-3">
        <a href={`mailto:${site.email}`} class="link-cta text-lg">{site.email}</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-cta text-lg">LinkedIn ↗</a>
      </div>

      <div class="mt-12 card p-6 bg-cream-dark">
        <p class="font-bold text-ink">¿Quieres saber si tu zona está libre?</p>
        <p class="mt-1 text-ink-soft">Dime tu oficio y tu ciudad y te lo digo, junto con cómo estás hoy en Google.</p>
        <a href="/consulta-tu-zona/" class="link-cta mt-4">Consultar mi zona →</a>
      </div>
    </div>
  </section>

</PageLayout>
