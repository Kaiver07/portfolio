---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';

const title = 'Contacto — ' + site.name;
const description = 'Escríbeme para hablar de SEO técnico, contenido con IA o email marketing para tu negocio local.';
---

<PageLayout title={title} description={description}>

  <section class="section-padding min-h-[60vh] flex items-center">
    <div class="section-container max-w-2xl">
      <h1 class="text-3xl lg:text-4xl font-bold text-ink mb-4">
        Hablemos de tu web
      </h1>
      <p class="text-ink-soft text-lg mb-10 max-w-xl">
        Cuéntame en qué punto está tu negocio y qué te gustaría conseguir. Te respondo directamente, sin
        intermediarios ni plantillas.
      </p>

      <div class="flex flex-col gap-3">
        <a href={`mailto:${site.email}`} class="link-cta text-lg">{site.email}</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-cta text-lg">LinkedIn ↗</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="link-cta text-lg">GitHub ↗</a>
      </div>
    </div>
  </section>

</PageLayout>
