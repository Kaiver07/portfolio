---
import PageLayout from '../../layouts/PageLayout.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, type Case } from '../../config/site.config';

export function getStaticPaths() {
  return site.cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Case };
const vertical = site.verticals.find((v) => v.slug === c.vertical)!;
const others = site.cases.filter((o) => o.slug !== c.slug);
const base = Astro.site?.toString() ?? '';

const title = `Caso: ${c.name}, web para ${vertical.trade} en ${c.place} | ${site.name}`;
const description = c.shortDesc;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: base },
    { '@type': 'ListItem', position: 2, name: 'Casos', item: `${base}casos/` },
    { '@type': 'ListItem', position: 3, name: c.name, item: `${base}casos/${c.slug}/` },
  ],
};
---

<PageLayout title={title} description={description} schema={schema}>

  <section>
    <div class="section-container pt-10 lg:pt-16 pb-12">
      <nav class="text-sm text-ink-soft mb-6" aria-label="Migas de pan">
        <a href="/" class="hover:text-ink">Inicio</a> <span aria-hidden="true">/</span>
        <a href="/casos/" class="hover:text-ink">Casos</a> <span aria-hidden="true">/</span> <span>{c.name}</span>
      </nav>
      <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold text-accent">{c.sector} · {c.place}{c.liveSince && ` · en producción desde ${c.liveSince}`}</p>
          <h1 class="mt-2 text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-ink">{c.name}</h1>
          <p class="mt-5 text-lg text-ink-soft leading-relaxed">{c.shortDesc}</p>
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="link-cta mt-6">Visitar la web ↗</a>
        </div>
        <BrowserFrame src={c.image} alt={`Portada de ${c.name}`} url={c.url} eager />
      </div>
    </div>
  </section>

  <section class="border-y border-ink/10 bg-cream-dark">
    <div class="section-container py-8 grid grid-cols-3 gap-6 max-w-3xl">
      {c.facts.map((f) => (
        <div>
          <p class="text-3xl lg:text-4xl font-extrabold text-ink">{f.value}</p>
          <p class="mt-1 text-sm text-ink-soft leading-snug">{f.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container grid gap-12 lg:grid-cols-[1fr_280px]">
      <div class="case-prose max-w-3xl">
        <h2>El punto de partida</h2>
        <p>{c.problem}</p>

        <h2>Qué se construyó</h2>
        <ul class="check-list !list-none space-y-3">
          {c.built.map((b) => <li>{b}</li>)}
        </ul>

        <h2>Decisiones que marcaron el proyecto</h2>
        <ul class="check-list !list-none space-y-3">
          {c.decisions.map((d) => <li>{d}</li>)}
        </ul>

        <h2>Resultado</h2>
        <p>{c.result}</p>
      </div>

      <aside class="lg:pt-8">
        <div class="phone w-48 mx-auto lg:mx-0">
          <img src={c.image.replace('.webp', '-movil.webp')} alt={`${c.name} en el móvil`} width="390" height="780" loading="lazy" class="block w-full h-auto" />
        </div>
        <p class="mt-4 text-sm text-ink-soft text-center lg:text-left">Así se ve en el móvil, donde llega la mayoría de las llamadas.</p>
        <a href={`/${vertical.slug}/`} class="mt-6 block card p-5 hover:border-accent transition-colors">
          <p class="text-sm text-ink-soft">¿Tienes un negocio parecido?</p>
          <p class="font-bold text-ink">Webs para {vertical.trade} →</p>
        </a>
      </aside>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container">
      <p class="eyebrow mb-6">Otros casos</p>
      <div class="grid gap-4 md:grid-cols-2">
        {others.map((o) => (
          <a href={`/casos/${o.slug}/`} class="card p-6 hover:border-accent transition-colors">
            <p class="text-sm font-semibold text-accent">{o.sector} · {o.place}</p>
            <p class="mt-1 text-lg font-bold text-ink">{o.name} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="¿Quieres algo así para tu negocio?" />

</PageLayout>
