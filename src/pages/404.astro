---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';

const title = `Página no encontrada | ${site.name}`;
const description = 'La página que buscas no existe o se ha movido.';
---

<PageLayout title={title} description={description}>

  <section class="section-padding min-h-[60vh] flex items-center">
    <div class="section-container max-w-xl">
      <p class="text-accent font-bold text-6xl mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-4">
        No hemos encontrado esta página
      </h1>
      <p class="text-ink-soft mb-8">
        Puede que el enlace esté roto o que la página se haya movido.
      </p>
      <div class="flex flex-wrap gap-x-8 gap-y-2">
        <a href="/" class="link-cta">Volver al inicio →</a>
        <a href="/contacto/" class="link-cta">Contacto →</a>
      </div>
    </div>
  </section>

</PageLayout>
