---
import PageLayout from '../layouts/PageLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site.config';

const title = `Sobre mí: datos reales, plantilla probada y seguimiento semanal | ${site.name}`;
const description =
  'Quién soy y cómo hago las webs para oficios: consulta gratis, datos reales del negocio, una base que ya funciona en otras webs y revisión cada semana.';
---

<PageLayout title={title} description={description}>

  <section>
    <div class="section-container pt-10 lg:pt-16 pb-12 max-w-3xl">
      <p class="eyebrow mb-4">Sobre mí</p>
      <h1 class="text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-ink">Si no es un dato real, no lo vas a ver en tu web</h1>
      <p class="mt-6 text-lg text-ink-soft leading-relaxed">
        Soy Yerai Jiménez. Trabajo solo, con negocios de oficios que necesitan que su web les traiga clientes. No soy
        una agencia y no lo voy a aparentar: hablas siempre conmigo.
      </p>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-ink">Paso a paso</h2>
      <ol class="mt-10 space-y-0">
        {site.process.map((p, i) => (
          <li class:list={['grid sm:grid-cols-[80px_1fr] gap-3 sm:gap-8 py-8', i > 0 && 'hairline']}>
            <span class="text-3xl font-extrabold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div class="max-w-2xl">
              <h3 class="text-xl font-bold text-ink">{p.title}</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-ink">Las reglas que no me salto</h2>
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {site.principles.map((p) => (
          <div class="card p-6">
            <p class="font-bold text-ink text-lg">{p.title}</p>
            <p class="mt-2 text-ink-soft leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <h2 class="text-3xl font-bold text-ink">Herramientas propias</h2>
        <p class="mt-4 text-ink-soft leading-relaxed">No uso un constructor de webs genérico. Estas herramientas las he hecho yo para estas webs:</p>
        <ul class="mt-8 space-y-6">
          {site.tools.map((t) => (
            <li>
              <p class="font-bold text-ink">{t.name}</p>
              <p class="mt-1 text-ink-soft leading-relaxed">{t.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <figure>
        <BrowserFrame src="/casos/dashboard-seo.webp" alt="Panel interno con los datos de Google de cada web, con las cifras difuminadas" />
        <figcaption class="mt-3 text-sm text-ink-soft">Las cifras están difuminadas a propósito: son de cada negocio.</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand />

</PageLayout>
