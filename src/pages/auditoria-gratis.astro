---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';

const title = `Auditoría gratis de tu web y tu ficha de Google | ${site.name}`;
const description =
  'Te digo gratis por qué tu web o tu ficha de Google no te traen llamadas en tu ciudad y qué haría para arreglarlo. Para empresas de oficios y reformas.';

const subject = 'Auditoría gratis';
const body = [
  'Hola Yerai, quiero la auditoría gratis.',
  '',
  'Nombre del negocio:',
  'Oficio:',
  'Ciudad y zonas donde trabajo:',
  'Web (si tengo):',
  'Enlace a mi ficha de Google (si tengo):',
  'Teléfono de contacto:',
].join('\n');
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const checks = [
  'Si sales en Google cuando buscan tu servicio en tu ciudad y en los pueblos de alrededor',
  'Tu ficha de Google: categorías, servicios, fotos, reseñas y si enlaza bien con la web',
  'Velocidad y cómo se ve tu web en el móvil',
  'Qué hace mejor tu competencia directa',
  'Las 3 cosas que yo haría primero',
];
---

<PageLayout title={title} description={description}>

  <section>
    <div class="section-container pt-10 lg:pt-16 pb-16 lg:pb-24 grid gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="eyebrow mb-4">Auditoría gratis</p>
        <h1 class="text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-ink">¿Por qué tu web no te trae llamadas?</h1>
        <p class="mt-6 text-lg text-ink-soft leading-relaxed max-w-xl">
          Mándame el nombre de tu negocio y tu ciudad. Te contesto con lo que veo y lo que haría, en lenguaje claro.
          Sin compromiso: si no trabajamos juntos, la auditoría es tuya igual.
        </p>
        <h2 class="mt-10 font-bold text-ink text-lg">Qué reviso</h2>
        <ul class="check-list mt-4 space-y-3 text-ink">
          {checks.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div class="card p-7 lg:p-8 bg-cream-dark self-start">
        <h2 class="text-xl font-bold text-ink">Pídela por email</h2>
        <p class="mt-2 text-ink-soft leading-relaxed">
          El botón abre tu correo con lo que necesito ya escrito. Solo tienes que rellenarlo.
        </p>
        <a href={mailto} class="btn-cta w-full mt-6 text-base">Pedir mi auditoría</a>
        <p class="mt-4 text-sm text-ink-soft">
          ¿Prefieres escribir tú? <a href={`mailto:${site.email}`} class="font-semibold text-ink underline">{site.email}</a>
        </p>
        <div class="mt-8 hairline pt-6 text-sm text-ink-soft space-y-2">
          <p><span class="font-semibold text-ink">Necesito:</span> nombre del negocio, oficio, ciudad y, si los tienes, tu web y tu ficha de Google.</p>
          <p><span class="font-semibold text-ink">Te contesto:</span> por email, con la auditoría escrita.</p>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
