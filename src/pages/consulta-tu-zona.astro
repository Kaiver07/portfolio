---
import PageLayout from '../layouts/PageLayout.astro';
import ZonesBoard from '../components/ZonesBoard.astro';
import { site } from '../config/site.config';

const title = `Consulta tu zona gratis: cómo estás en Google frente a tu competencia | ${site.name}`;
const description =
  'Dime tu oficio y tu ciudad: te digo cómo estás hoy en Google frente a tu competencia y qué web haría falta para tener la mejor de tu zona. Gratis y sin compromiso.';

const subject = 'Consulta de zona';
const body = [
  'Hola Yerai, quiero saber cómo está mi zona en Google.',
  '',
  'Oficio:',
  'Ciudad y pueblos donde trabajo:',
  'Nombre del negocio:',
  'Web (si tengo):',
  'Enlace a mi ficha de Google (si tengo):',
  'Teléfono de contacto:',
].join('\n');
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const checks = [
  'Si sales hoy en Google cuando buscan tu servicio en tu ciudad y en los pueblos de alrededor',
  'Cómo está tu ficha de Google: categorías, fotos, reseñas y enlace a la web',
  'Qué hace tu competencia directa',
  'Qué te propondría, aunque luego no trabajemos juntos',
];
---

<PageLayout title={title} description={description}>

  <section>
    <div class="section-container pt-10 lg:pt-16 pb-16 lg:pb-24 grid gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="eyebrow mb-4">Consulta gratis</p>
        <h1 class="text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-ink">¿Quién tiene la mejor web de tu zona?</h1>
        <p class="mt-6 text-lg text-ink-soft leading-relaxed max-w-xl">
          Dime a qué te dedicas y dónde. Miro las webs de tu competencia en Google y te contesto con lo que veo y lo
          que haría para que la mejor de tu zona sea la tuya, en lenguaje claro y sin compromiso.
        </p>
        <h2 class="mt-10 font-bold text-ink text-lg">Qué te digo</h2>
        <ul class="check-list mt-4 space-y-3 text-ink">
          {checks.map((c) => <li>{c}</li>)}
        </ul>
        <div class="mt-10">
          <ZonesBoard compact />
        </div>
      </div>

      <div class="card p-7 lg:p-8 bg-cream-dark self-start">
        <h2 class="text-xl font-bold text-ink">Escríbeme por WhatsApp</h2>
        <p class="mt-2 text-ink-soft leading-relaxed">
          El botón abre WhatsApp con el mensaje ya escrito. Solo tienes que poner tu oficio y tu ciudad.
        </p>
        <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-cta w-full mt-6 text-base">Consultar por WhatsApp</a>
        <p class="mt-4 text-sm text-ink-soft">
          O llámame al <a href={`tel:${site.phoneIntl}`} class="font-semibold text-ink underline">{site.phone}</a>, o
          <a href={mailto} class="font-semibold text-ink underline">escríbeme un email</a>.
        </p>
        <div class="mt-8 hairline pt-6 text-sm text-ink-soft space-y-2">
          <p><span class="font-semibold text-ink">Necesito:</span> oficio, ciudad y, si los tienes, tu web y tu ficha de Google.</p>
          <p><span class="font-semibold text-ink">Te contesto:</span> yo mismo, por WhatsApp o por email.</p>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
