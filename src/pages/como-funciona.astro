---
import PageLayout from '../layouts/PageLayout.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site.config';

const { offer } = site;
const title = `Cómo funciona: la mejor web de tu zona, con cuota mensual | ${site.name}`;
const description =
  'La web más completa de tu oficio en tu ciudad: tú recibes las llamadas y pagas una cuota al mes, sin inversión inicial. También webs en propiedad y ficha de Google.';
const base = Astro.site?.toString() ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: offer.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  url: `${base}como-funciona/`,
};
---

<PageLayout title={title} description={description} schema={schema}>

  <section>
    <div class="section-container pt-10 lg:pt-16 pb-12 max-w-3xl">
      <p class="eyebrow mb-4">Cómo funciona</p>
      <h1 class="text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-ink">No te vendo una web. Te pongo la mejor de tu zona a trabajar para ti.</h1>
      <p class="mt-6 text-lg text-ink-soft leading-relaxed">{offer.summary}</p>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-ink">Paso a paso</h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {offer.steps.map((p, i) => (
          <li>
            <span class="flex w-9 h-9 items-center justify-center rounded-full bg-accent-light text-accent-dark font-bold">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold text-ink">{p.title}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-ink">Qué incluye</h2>
        <ul class="check-list mt-6 space-y-3 text-ink">
          {offer.includes.map((x) => <li>{x}</li>)}
        </ul>
        <div class="mt-10 card p-6 bg-cream-dark">
          <p class="font-bold text-ink">¿Y el precio?</p>
          <p class="mt-2 text-ink-soft leading-relaxed">{offer.priceText}</p>
        </div>
      </div>
      <div>
        <h2 class="text-3xl font-bold text-ink">Frente a pagar una web a una agencia</h2>
        <div class="mt-6 card overflow-hidden">
          <table class="w-full text-left text-sm">
            <thead class="bg-cream-dark">
              <tr>
                <th scope="col" class="p-4 font-semibold text-ink-soft"><span class="sr-only">Aspecto</span></th>
                <th scope="col" class="p-4 font-semibold text-ink-soft">Web de agencia</th>
                <th scope="col" class="p-4 font-bold text-ink">Conmigo</th>
              </tr>
            </thead>
            <tbody>
              {offer.comparison.map((r) => (
                <tr class="border-t border-ink/10 align-top">
                  <th scope="row" class="p-4 font-semibold text-ink">{r.label}</th>
                  <td class="p-4 text-ink-soft">{r.agency}</td>
                  <td class="p-4 text-ink font-medium">{r.me}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-ink">En qué me diferencio</h2>
      <p class="mt-3 text-ink-soft max-w-2xl leading-relaxed">Hay más gente que alquila webs o vende contactos. Esto es lo que yo hago distinto.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {site.differentiators.map((d) => (
          <div class="card p-6">
            <p class="font-bold text-ink text-lg">{d.title}</p>
            <p class="mt-2 text-ink-soft leading-relaxed">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-ink">Lo que no te voy a prometer</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {site.noPromises.map((n) => (
          <div class="card p-6">
            <p class="font-bold text-ink"><span class="text-accent mr-1" aria-hidden="true">✕</span> {n.title}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{n.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="section-container max-w-3xl">
      <h2 class="text-3xl font-bold text-ink mb-4">Preguntas frecuentes</h2>
      <Faq items={offer.faqs} />
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-ink">Si prefieres no pagar cuota</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {site.extras.map((e) => (
          <article id={e.slug} class="card p-7 scroll-mt-28">
            <h3 class="text-xl font-bold text-ink">{e.name}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{e.summary}</p>
            <ul class="check-list mt-5 space-y-2.5 text-ink">
              {e.includes.map((x) => <li>{x}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />

</PageLayout>
