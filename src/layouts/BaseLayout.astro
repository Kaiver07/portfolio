---
import { site } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  schema?: object | object[];
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  ogImage = site.defaultOgImage,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${Astro.site}#person`,
  name: site.name,
  url: Astro.site?.toString(),
  email: site.email,
  telephone: site.phoneIntl,
  sameAs: [site.linkedin, site.github],
  jobTitle: site.role,
};

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${Astro.site}#negocio`,
  name: `${site.name} · ${site.role}`,
  url: Astro.site?.toString(),
  email: site.email,
  telephone: site.phoneIntl,
  founder: { '@id': `${Astro.site}#person` },
  areaServed: { '@type': 'Country', name: 'España' },
  knowsAbout: ['SEO local', 'Diseño web', 'Google Business Profile', 'Astro'],
  makesOffer: [
    { name: site.offer.name, summary: site.offer.summary },
    ...site.extras.map((e) => ({ name: e.name, summary: e.summary })),
  ].map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.name, description: s.summary },
  })),
};

const schemas = [
  personSchema,
  businessSchema,
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO core -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

    <!-- Vercel Analytics (visitas básicas, plan gratuito) -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
