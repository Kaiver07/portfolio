---
import { site } from '../config/site.config';
const year = new Date().getFullYear();
---

<footer class="hairline">
  <div class="section-container py-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="text-sm text-ink-soft">
      <p>© {year} {site.name} · <a href={`mailto:${site.email}`} class="hover:text-ink transition-colors">{site.email}</a></p>
    </div>

    <nav class="flex items-center gap-5 text-sm text-ink-soft" aria-label="Enlaces">
      <a href="/#servicios" class="hover:text-ink transition-colors">Servicios</a>
      <a href="/#proyecto" class="hover:text-ink transition-colors">Proyecto</a>
      <a href="/contacto/" class="hover:text-ink transition-colors">Contacto</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">GitHub</a>
    </nav>
  </div>
</footer>
