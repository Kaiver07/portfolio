---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = '¿Quieres la mejor web de tu zona?',
  text = 'Dime tu oficio y tu ciudad. Te digo cómo estás hoy en Google frente a tu competencia y qué haría para ganarle. Gratis y sin compromiso.',
} = Astro.props;
---

<section class="bg-ink text-cream">
  <div class="section-container py-16 lg:py-20 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
    <div class="max-w-2xl">
      <h2 class="text-3xl lg:text-4xl font-bold leading-tight">{title}</h2>
      <p class="mt-4 text-lg text-cream/70 leading-relaxed">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/consulta-tu-zona/" class="btn-cta text-base">Consultar mi zona</a>
      <a href="/como-funciona/" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-cream/25 font-semibold hover:border-cream transition-colors">Cómo funciona</a>
    </div>
  </div>
</section>
